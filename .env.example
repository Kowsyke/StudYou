# StudYou Platform Master Environment Setup & Azure Deployment Guide
# ===================================================================
# This file serves as both your local .env template and an Azure deployment guide.
# To configure your local environment, copy this file to .env in the workspace root.
# ALWAYS SAVE YOUR .env FILE AFTER EDITING. UNSAVED CHANGES WILL CAUSE DB & AUTH FAILURES.

# ===================================================================
# 1. LOCAL DEVELOPMENT (.env) CONFIGURATION
# ===================================================================

# Database Connection (Local Docker or Local Postgres Instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyou

# Authentication & Security
# Generate a fresh one locally, e.g.: openssl rand -base64 48
# Never commit a real secret to this tracked example file.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Network & Server Port Settings
PORT=3005
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Initial Admin Seeding Account (Used by pnpm db:seed)
ADMIN_EMAIL=admin@studyou.app
ADMIN_PASSWORD=change_this_admin_password_123

# ===================================================================
# 2. PULL EXISTING AZURE APP SETTINGS DIRECTLY TO YOUR .env FILE
# ===================================================================
# Use these commands in Azure Cloud Shell or local terminal with Azure CLI logged in.

# Command A: Print all current Azure App Settings formatted as KEY=VALUE:
# az webapp config appsettings list -g studyou-rg -n studyou-app-7097 --query "[].join('=', [name, value])" --output tsv

# Command B: Print all Azure App Settings in a clean table view:
# az webapp config appsettings list -g studyou-rg -n studyou-app-7097 --query "[].{Key:name, Value:value}" --output table

# Command C: Save all Azure App Settings directly to your local .env file:
# CAUTION: this OVERWRITES your local .env with PRODUCTION settings (production
# DATABASE_URL, NODE_ENV=production, WEBSITES_PORT=8080). Running the dev server
# afterwards points it at the live production database. Only run this if you
# intend that; otherwise keep the local development values from section 1 above.
# az webapp config appsettings list -g studyou-rg -n studyou-app-7097 --query "[].join('=', [name, value])" --output tsv > .env

# ===================================================================
# 3. SET OR UPDATE AZURE PRODUCTION APP SETTINGS
# ===================================================================
# az webapp config appsettings set -g studyou-rg -n studyou-app-7097 --output none --settings \
#   DATABASE_URL="postgresql://studyou_admin:YOUR_DB_PASSWORD@studyou-db-22637.postgres.database.azure.com/studyou?sslmode=require" \
#   JWT_SECRET="YOUR_JWT_SECRET" \
#   JWT_EXPIRES_IN="7d" \
#   CLIENT_URL="https://studyou-app-7097.azurewebsites.net" \
#   NODE_ENV="production" \
#   ADMIN_EMAIL="admin@studyou.app" \
#   ADMIN_PASSWORD="SetYourSecureAdminPassword123!" \
#   SCM_DO_BUILD_DURING_DEPLOYMENT="false"
